{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022"],
		"types": ["node"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowJs": false,
		"verbatimModuleSyntax": true,
		"resolveJsonModule": true
	},
	"include": ["extensions/**/*.ts", "tests/**/*.ts", "vitest.config.ts"],
	"exclude": ["node_modules"]
}
