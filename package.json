{
	"name": "pi-dev-browser",
	"version": "0.0.1",
	"description": "GitHub-installable Pi browser automation package backed by dev-browser CLI",
	"type": "module",
	"license": "MIT",
	"author": "Magi Metal",
	"keywords": [
		"pi-package",
		"pi-dev-browser",
		"browser",
		"automation",
		"playwright",
		"screenshots",
		"dev-browser"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/magimetal/pi-dev-browser.git"
	},
	"homepage": "https://github.com/magimetal/pi-dev-browser",
	"bugs": {
		"url": "https://github.com/magimetal/pi-dev-browser/issues"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"files": [
		"extensions",
		"docs/commands.md",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"scripts": {
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest --run",
		"check": "npm run lint && npm run typecheck && npm test"
	},
	"pi": {
		"extensions": [
			"./extensions/dev-browser.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "^1.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.4",
		"@earendil-works/pi-coding-agent": "0.74.0",
		"@earendil-works/pi-tui": "0.74.0",
		"@types/node": "25.6.0",
		"typebox": "1.1.31",
		"typescript": "6.0.3",
		"vitest": "4.1.0"
	}
}
